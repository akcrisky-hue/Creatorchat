# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Admin/server authentication
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Razorpay
RAZORPAY_KEY_ID=rzp_live_replace_me
# Production must use an rzp_live_ key; never commit the real key.
RAZORPAY_KEY_SECRET=replace-me

# RazorpayX UPI validation (required only if using UPI verification)
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=replace-with-razorpayx-source-account

# Optional production hardening
APP_ORIGIN=https://your-domain.example

# Cloudflare R2 production post media storage
R2_ACCOUNT_ID=replace_me
R2_BUCKET=creatorchat-media
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
